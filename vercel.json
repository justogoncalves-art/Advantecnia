{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/dashboard", "destination": "/dashboard.dc.html" },
    { "source": "/api/login", "destination": "/api/session?action=login" },
    { "source": "/api/logout", "destination": "/api/session?action=logout" },
    { "source": "/api/me", "destination": "/api/session?action=me" },
    { "source": "/p/:token/archivo", "destination": "/api/view?token=:token&f=1" },
    { "source": "/p/:token", "destination": "/api/view?token=:token" },
    { "source": "/baja", "destination": "/api/unsubscribe" }
  ],
  "crons": [
    { "path": "/api/refresh?days=3", "schedule": "0 6 * * *" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/at.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/baja",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/dashboard(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/p/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
